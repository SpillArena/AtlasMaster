# Cloudflare Pages: headers for this game's static files (served behind the
# spillarena.no router, which strips the /<game> prefix).
#
# No script-src/connect-src here on purpose: this game loads fonts and images
# from outside origins, and a full CSP needs testing in a browser first. The
# directives below are the ones that cannot break a page.
/*
  Content-Security-Policy: base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000

# Vite puts a content hash in every file name under /assets, so a changed file
# is a new URL and the old one can be cached for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
