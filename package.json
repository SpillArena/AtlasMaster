{
  "name": "atlasmaster",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node node_modules/typescript7/bin/tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "data:norway": "node scripts/build-norway.mjs",
    "data:europe": "node scripts/build-europe-countries.mjs",
    "data:asia": "node scripts/build-asia.mjs",
    "data:africa": "node scripts/build-africa.mjs",
    "data:south-america": "node scripts/build-south-america.mjs",
    "data:usa": "node scripts/build-usa.mjs",
    "data:world": "node scripts/build-world.mjs",
    "data:landing": "node scripts/build-landing-borders.mjs",
    "data:north-america": "node scripts/build-remaining-regions.mjs north-america",
    "data:oceania": "node scripts/build-remaining-regions.mjs oceania",
    "data:antarctica": "node scripts/build-remaining-regions.mjs antarctica",
    "data:oceans": "node scripts/build-remaining-regions.mjs oceans",
    "icons": "node scripts/build-icons.mjs",
    "check:sql": "node --experimental-sqlite scripts/check-leaderboard-sql.mjs",
    "check:geo": "node --experimental-strip-types --import ./scripts/lib/ts-register.mjs scripts/check-geo.mjs",
    "check:regions": "node scripts/check-regions.mjs",
    "check:engine": "node --experimental-strip-types --import ./scripts/lib/ts-register.mjs scripts/check-engine.mjs",
    "bench:map": "node scripts/bench-map.mjs"
  },
  "dependencies": {
    "d3-geo": "^3.1.2",
    "d3-selection": "^3.0.1",
    "d3-zoom": "^3.0.1",
    "framer-motion": "^14.9.1",
    "i18next": "^26.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.12",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@mapbox/geojson-rewind": "^0.5.2",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  }
}
